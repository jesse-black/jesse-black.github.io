---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import portrait from '../assets/portrait.jpg';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import {
	AUTHOR_NAME,
	BLOG_RAW_SOURCE_URL,
	BLOG_SOURCE_URL,
	GITHUB_PROFILE_URL,
} from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { id?: string; body?: string; slug?: string };

const { title, description, pubDate, updatedDate, heroImage, id, slug } = Astro.props;
const githubSourceUrl = id ? `${BLOG_SOURCE_URL}/${id}` : null;
const githubRawSourceUrl = id ? `${BLOG_RAW_SOURCE_URL}/${id}` : null;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} ogImage={slug ? `/og/${slug}.png` : undefined} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-light));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.byline {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.5em;
				margin: 0.75em 0 0.25em;
				font-size: 0.9em;
				color: rgb(var(--gray-light));
			}
			.byline a {
				display: inline-flex;
				align-items: center;
				gap: 0.5em;
				color: inherit;
				text-decoration: none;
			}
			.byline a:hover {
				color: var(--accent);
			}
			.byline img {
				width: 32px;
				height: 32px;
				border-radius: 50%;
				object-fit: cover;
			}
				.post-actions {
					display: flex;
					gap: 0.75em;
					margin: 0.5em 0 0;
					justify-content: center;
				}
				.post-actions a,
				.post-actions button {
					display: inline-flex;
					align-items: center;
					gap: 0.4em;
					font-size: 0.875em;
					color: rgb(var(--gray));
					text-decoration: none;
					background: none;
					border: none;
					cursor: pointer;
					padding: 0;
					font-family: inherit;
				}
				.post-actions a:hover,
				.post-actions button:hover {
					color: rgb(var(--gray-light));
				}
				.post-actions button.copied {
					color: rgb(var(--white));
				}
				.post-actions button .copy-feedback__icon--check {
					display: none;
				}
				.post-actions button.copied .copy-feedback__icon--copy {
					display: none;
				}
				.post-actions button.copied .copy-feedback__icon--check {
					display: inline-flex;
				}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<div class="byline">
							<a href={GITHUB_PROFILE_URL} target="_blank" rel="noopener noreferrer">
								<Image src={portrait} width={64} height={64} alt={AUTHOR_NAME} />
								{AUTHOR_NAME}
							</a>
						</div>
						<div class="post-actions">
							{githubSourceUrl && (
							<a href={githubSourceUrl} target="_blank" rel="noopener noreferrer">
								<Icon name="simple-icons:github" width="16" height="16" aria-hidden="true" />
								View on GitHub
							</a>
						)}
								<button
									id="copy-btn"
									data-copy-source="markdown"
									data-copy-url={githubRawSourceUrl ?? undefined}
									data-default-label="Copy markdown"
									data-copied-label="Copied!"
									aria-label="Copy markdown"
									type="button"
								>
									<span class="copy-feedback__icon copy-feedback__icon--copy">
										<Icon name="lucide:copy" width="16" height="16" aria-hidden="true" />
									</span>
									<span class="copy-feedback__icon copy-feedback__icon--check">
										<Icon name="lucide:check" width="16" height="16" aria-hidden="true" />
									</span>
									<span data-copy-label>Copy markdown</span>
								</button>
							</div>
						<hr />
					</div>
					<slot />
					<hr />
					<Comments />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<script>
	const copyResetTimers = new WeakMap<HTMLButtonElement, number>();

	function setCopiedState(button: HTMLButtonElement) {
		const label = button.querySelector('[data-copy-label]');
		if (!(label instanceof HTMLElement)) return;

		const existingTimer = copyResetTimers.get(button);
		if (existingTimer) {
			window.clearTimeout(existingTimer);
		}

		button.classList.add('copied');
		label.textContent = button.dataset.copiedLabel ?? 'Copied!';

		const resetTimer = window.setTimeout(() => {
			button.classList.remove('copied');
			label.textContent = button.dataset.defaultLabel ?? 'Copy';
			copyResetTimers.delete(button);
		}, 2000);

		copyResetTimers.set(button, resetTimer);
	}

	document.querySelectorAll('.code-block').forEach((block) => {
		if (!(block instanceof HTMLElement)) return;

		const pre = block.querySelector('pre');
		const label = block.querySelector('.code-block-language');
		const button = block.querySelector('.copy-code-button');
		const lang = pre?.getAttribute('data-language');

		if (lang && label instanceof HTMLElement) {
			label.textContent = lang;
		}

		if (lang && button instanceof HTMLButtonElement) {
			button.setAttribute('aria-label', `Copy ${lang} code`);
		}
	});

	document.querySelectorAll('[data-copy-source]').forEach((button) => {
		if (!(button instanceof HTMLButtonElement)) return;

		button.addEventListener('click', async () => {
			try {
				let text = '';

				if (button.dataset.copySource === 'code') {
					const code = button.closest('.code-block')?.querySelector('pre code');
					if (!(code instanceof HTMLElement)) return;
					text = code.innerText;
				} else if (button.dataset.copySource === 'markdown') {
					const copyUrl = button.dataset.copyUrl;
					if (!copyUrl) return;

					const response = await fetch(copyUrl);
					if (!response.ok) {
						throw new Error(`Failed to fetch markdown: ${response.status}`);
					}

					text = await response.text();
				}

				await navigator.clipboard.writeText(text);
				setCopiedState(button);
			} catch (error) {
				console.error('Copy failed', error);
			}
		});
	});
</script>
